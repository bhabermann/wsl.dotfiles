# Machine-local corporate CA refresh configuration.
# This file is copied to ~/.config/dotfiles/corporate-ca.env when the
# work profile runs the corporate CA refresh. Keep company-specific hosts,
# URLs, and certificate authority names out of this repository.

HOSTS=(
  # "github.com"
)

# Only install CA certificates where Subject or Issuer matches this regex.
# Example: ALLOWLIST_REGEX="Example Root CA|Example TLS Inspection"
ALLOWLIST_REGEX=""

TEST_URLS=(
  # "https://github.com"
)

# On WSL, the helper can import allowlisted CA certificates from these Windows
# certificate stores before fetching host chains. Narrow ALLOWLIST_REGEX first.
WINDOWS_CERT_STORES=(
  "Cert:\\LocalMachine\\Root"
  "Cert:\\LocalMachine\\CA"
  "Cert:\\CurrentUser\\Root"
  "Cert:\\CurrentUser\\CA"
)

CURL_CONNECT_TIMEOUT="8"
CURL_MAX_TIME="20"
