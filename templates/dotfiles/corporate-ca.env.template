# Machine-local corporate CA refresh configuration.
# This file is copied to ~/.config/dotfiles/corporate-ca.env when the
# work profile runs the corporate CA refresh. Keep company-specific hosts,
# URLs, and certificate authority names out of this repository.
#
# You may add custom configuration above the BEGIN marker or below the END marker.
# Content between markers is managed by the dotfiles installer.
#
# TIP: On WSL, the script automatically imports all CA:TRUE certificates
# from the Windows certificate stores into Linux trust. This means corporate
# root CAs pushed via GPO are trusted in WSL without any manual configuration.
#
# To restrict which Windows CAs are imported, set ALLOWLIST_REGEX below the
# END marker to a regex matching only the CAs you want:
#
#   ALLOWLIST_REGEX="YourCorporateCA|AnotherCA"
#
# Expired CA certificates are automatically skipped.
#
# If your network performs TLS interception and a CA is not in the Windows
# stores, you can add the intercepted hosts below the END marker so the
# script captures the issuer chain directly from the TLS connection:
#
#   HOSTS+=(
#     "example.com"
#   )
#   TEST_URLS+=(
#     "https://example.com"
#   )

# BEGIN DOTFILES MANAGED
HOSTS=(
  "mise-versions.jdx.dev"
  "github.com"
  "download.docker.com"
  "ppa.launchpadcontent.net"
)

# Host-captured CA certificates are installed when Subject or Issuer matches
# this regex, or when HOST_CHAIN_ISSUER_IMPORT is enabled and the CA issues
# another certificate in a configured host chain.
ALLOWLIST_REGEX=""

TEST_URLS=(
  "https://mise-versions.jdx.dev/data/go.toml"
  "https://github.com"
  "https://download.docker.com/linux/ubuntu/gpg"
)

# On WSL, the helper can import CA certificates from these Windows stores when
# their Subject matches an issuer from the configured host certificate chains.
WINDOWS_TRUSTED_ISSUER_IMPORT="1"
HOST_CHAIN_ISSUER_IMPORT="1"
WINDOWS_CERT_STORES=(
  "Cert:\\LocalMachine\\Root"
  "Cert:\\LocalMachine\\CA"
  "Cert:\\CurrentUser\\Root"
  "Cert:\\CurrentUser\\CA"
)

CURL_CONNECT_TIMEOUT="8"
CURL_MAX_TIME="20"
# END DOTFILES MANAGED
