[include]
  path = ~/.config/git/identity.gitconfig
[core]
  autocrlf = input
[init]
  defaultBranch = main
[fetch]
  prune = true
[push]
  autoSetupRemote = true
[rerere]
  enabled = true
[alias]
  co = checkout
  st = status
  br = branch
  ci = commit
  lg = log --oneline --graph --decorate --all
  last = log -1 HEAD --stat
