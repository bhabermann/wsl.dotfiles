FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    coreutils \
    curl \
    diffutils \
    findutils \
    git \
    grep \
    sed \
    zsh \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace

RUN chmod +x /workspace/setup /workspace/install/*.sh /workspace/scripts/*.sh

CMD ["/workspace/scripts/test-in-docker.sh"]
