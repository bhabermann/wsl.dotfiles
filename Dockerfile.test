FROM debian:13-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends bash git zsh ca-certificates curl starship zoxide fzf && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY . /workspace
RUN chmod +x setup install/*.sh scripts/*.sh scripts/docker-wsl scripts/wslview
CMD ["bash", "/workspace/scripts/test-linux.sh"]
