# Bash-specific interactive-shell configuration.

source "$HOME/.config/dotfiles/shell/shared.sh"

HISTFILE="${HISTFILE:-$HOME/.bash_history}"
HISTSIZE=50000
HISTFILESIZE=50000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  source /usr/share/bash-completion/bash_completion
elif [[ -r /etc/bash_completion ]]; then
  source /etc/bash_completion
fi

if [[ "${DOTFILES_MISE_ACTIVATE:-0}" == 1 && -x /usr/bin/mise ]]; then
  eval "$(/usr/bin/mise activate bash)"
elif [[ "${DOTFILES_MISE_ACTIVATE:-0}" == 1 && -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate bash)"
fi
[[ ! -x /usr/bin/zoxide ]] || eval "$(/usr/bin/zoxide init bash)"
[[ ! -x /usr/bin/direnv ]] || eval "$(/usr/bin/direnv hook bash)"
[[ ! -x /usr/bin/fzf ]] || eval "$(/usr/bin/fzf --bash)"
[[ ! -x /usr/bin/atuin ]] || eval "$(/usr/bin/atuin init bash)"
if [[ "$TERM" != dumb && -x /usr/bin/starship ]]; then eval "$(/usr/bin/starship init bash)"; fi
