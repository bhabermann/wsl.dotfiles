# Only inspect distro/local binaries: probing absent tools across the Windows
# PATH is expensive on WSL. Windows interoperability remains available.
source "$HOME/.config/dotfiles/shell/shared.sh"
HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS SHARE_HISTORY HIST_REDUCE_BLANKS HIST_VERIFY EXTENDED_HISTORY
bindkey -e
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward
fpath=("$HOME/.zsh/plugins/zsh-completions/src" $fpath)
autoload -Uz compinit
mkdir -p "$HOME/.cache"
compinit -C -d "$HOME/.cache/zcompdump"
zstyle ':completion:*' menu select
if [[ "${DOTFILES_MISE_ACTIVATE:-0}" == 1 && -x /usr/bin/mise ]]; then
  eval "$(/usr/bin/mise activate zsh)"
elif [[ "${DOTFILES_MISE_ACTIVATE:-0}" == 1 && -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi
[[ ! -x /usr/bin/zoxide ]] || eval "$(/usr/bin/zoxide init zsh)"
[[ ! -x /usr/bin/direnv ]] || eval "$(/usr/bin/direnv hook zsh)"
# Slim rootfs excludes documentation, including Debian's example scripts.
[[ ! -x /usr/bin/fzf ]] || eval "$(/usr/bin/fzf --zsh)"
[[ ! -x /usr/bin/atuin ]] || eval "$(/usr/bin/atuin init zsh)"
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ "$TERM" != dumb && -x /usr/bin/starship ]]; then eval "$(/usr/bin/starship init zsh)"; fi
# Load after all widgets have been registered.
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
