#!/usr/bin/env bash
set -euo pipefail

PROGRAM="update-corporate-ca"
VERSION="1.0.0"
DEFAULT_CONFIG="${HOME:-/tmp}/.config/dotfiles/corporate-ca.env"
CERT_DIR="/usr/local/share/ca-certificates"
CERT_PREFIX="corporate-proxy-ca-"
WORKDIR="$(mktemp -d /tmp/update-corporate-ca.XXXXXX)"

HOSTS=()
TEST_URLS=()
ALLOWLIST_REGEX=""
CURL_CONNECT_TIMEOUT="8"
CURL_MAX_TIME="20"

DRY_RUN=0
VERBOSE=0
DO_CLEANUP=0
CONFIG_FILE="$DEFAULT_CONFIG"
PRINT_CONFIG=0
LOG_ENABLED=1
DEFAULT_LOG_FILE="${HOME:-/tmp}/.cache/update-corporate-ca.log"
LOG_FILE="${LOG_FILE:-$DEFAULT_LOG_FILE}"

cleanup_tmp() { rm -rf "$WORKDIR"; }
trap cleanup_tmp EXIT

timestamp() { date +"%Y-%m-%d %H:%M:%S%z"; }

log() {
  local msg="$*"
  printf "%s\n" "$msg"
  if [[ "$LOG_ENABLED" -eq 1 ]]; then
    mkdir -p "$(dirname "$LOG_FILE")" >/dev/null 2>&1 || true
    printf "%s %s\n" "$(timestamp)" "$msg" >> "$LOG_FILE" 2>/dev/null || true
  fi
}

warn() {
  local msg="WARNING: $*"
  printf "%s\n" "$msg" >&2
  if [[ "$LOG_ENABLED" -eq 1 ]]; then
    mkdir -p "$(dirname "$LOG_FILE")" >/dev/null 2>&1 || true
    printf "%s %s\n" "$(timestamp)" "$msg" >> "$LOG_FILE" 2>/dev/null || true
  fi
}

err() {
  local msg="ERROR: $*"
  printf "%s\n" "$msg" >&2
  if [[ "$LOG_ENABLED" -eq 1 ]]; then
    mkdir -p "$(dirname "$LOG_FILE")" >/dev/null 2>&1 || true
    printf "%s %s\n" "$(timestamp)" "$msg" >> "$LOG_FILE" 2>/dev/null || true
  fi
}

debug() { [[ "$VERBOSE" -eq 1 ]] && log "DEBUG: $*" || true; }

usage() {
  cat <<EOF
$PROGRAM $VERSION

Purpose:
  Capture corporate TLS interception CA certificates from configured hosts,
  install only allowlisted CA certificates into Linux trust, and run HTTPS tests.

Usage:
  $PROGRAM [options]

Options:
  --cleanup          Remove certificates installed by this tool (${CERT_PREFIX}*.crt).
  --dry-run          Show what would be installed or removed without changing trust.
  --config FILE      Load config file (default: $DEFAULT_CONFIG).
  --print-config     Print effective configuration and exit.
  --verbose          Enable debug logs.
  --no-log           Disable logging.
  --log-file FILE    Override log file path.
  -h, --help         Show help.

Notes:
  - Keep company-specific hosts, URLs, and allowlists in local config only.
  - Only certificates with CA:TRUE and Subject or Issuer matching ALLOWLIST_REGEX are installed.
  - Run as a normal user; sudo is used only when updating system trust.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cleanup) DO_CLEANUP=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --config) CONFIG_FILE="${2:-}"; shift 2 ;;
    --print-config) PRINT_CONFIG=1; shift ;;
    --verbose) VERBOSE=1; shift ;;
    --no-log) LOG_ENABLED=0; shift ;;
    --log-file) LOG_FILE="${2:-}"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    *) err "Unknown argument: $1"; usage; exit 2 ;;
  esac
done

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || { err "Missing dependency: $1"; exit 1; }
}

load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    err "Config file not found: $CONFIG_FILE"
    err "Create it from templates/dotfiles/corporate-ca.env.template or rerun ./setup install --profile work --with corporate-ca."
    exit 1
  fi
  debug "Loading config: $CONFIG_FILE"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
}

print_config() {
  log "$PROGRAM configuration:"
  log "  CONFIG_FILE          = $CONFIG_FILE"
  log "  CERT_DIR             = $CERT_DIR"
  log "  CERT_PREFIX          = $CERT_PREFIX"
  log "  ALLOWLIST_REGEX      = $ALLOWLIST_REGEX"
  log "  LOG_FILE             = $LOG_FILE"
  log "  CURL_CONNECT_TIMEOUT = $CURL_CONNECT_TIMEOUT"
  log "  CURL_MAX_TIME        = $CURL_MAX_TIME"
  log "  HOSTS                ="
  for host in "${HOSTS[@]}"; do log "    - $host"; done
  log "  TEST_URLS            ="
  for url in "${TEST_URLS[@]}"; do log "    - $url"; done
}

validate_config() {
  if [[ "${#HOSTS[@]}" -eq 0 ]]; then
    err "HOSTS is empty in $CONFIG_FILE"
    return 1
  fi
  if [[ -z "$ALLOWLIST_REGEX" ]]; then
    err "ALLOWLIST_REGEX is empty in $CONFIG_FILE"
    return 1
  fi
}

ensure_tmp_permissions() {
  if [[ ! -w /tmp ]]; then
    warn "/tmp is not writable. Attempting to fix permissions with sudo."
    sudo chmod 1777 /tmp
  fi
}

is_valid_x509() { openssl x509 -in "$1" -noout >/dev/null 2>&1; }
is_ca_true() { openssl x509 -in "$1" -noout -text 2>/dev/null | grep -q "CA:TRUE"; }
subject_line() { openssl x509 -in "$1" -noout -subject 2>/dev/null | sed 's/^subject= *//'; }
issuer_line() { openssl x509 -in "$1" -noout -issuer 2>/dev/null | sed 's/^issuer= *//'; }
enddate_line() { openssl x509 -in "$1" -noout -enddate 2>/dev/null | sed 's/^notAfter=//'; }

sha256_fp() {
  openssl x509 -in "$1" -noout -fingerprint -sha256 2>/dev/null \
    | sed -E 's/^SHA256 Fingerprint=//; s/://g; s/[[:space:]]//g'
}

matches_allowlist() {
  local subj iss
  subj="$(subject_line "$1")"
  iss="$(issuer_line "$1")"
  printf "%s %s\n" "$subj" "$iss" | grep -Eiq "$ALLOWLIST_REGEX"
}

install_cert_pem() {
  local pem="$1" fp dest subj iss exp
  fp="$(sha256_fp "$pem")"
  [[ -n "$fp" ]] || return 1

  dest="$CERT_DIR/${CERT_PREFIX}${fp}.crt"
  subj="$(subject_line "$pem")"
  iss="$(issuer_line "$pem")"
  exp="$(enddate_line "$pem")"

  if [[ -f "$dest" ]]; then
    debug "Already installed: $dest"
    return 0
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: Would install CA certificate:"
    log "  File:    $dest"
    log "  Subject: $subj"
    log "  Issuer:  $iss"
    log "  Expires: $exp"
    return 0
  fi

  sudo cp "$pem" "$dest"
  log "Installed CA certificate:"
  log "  File:    $dest"
  log "  Subject: $subj"
  log "  Issuer:  $iss"
  log "  Expires: $exp"
}

cleanup_installed_certs() {
  log "Cleanup requested: removing certificates installed by this tool."
  local pattern="$CERT_DIR/${CERT_PREFIX}"'*.crt'
  local found=0

  # shellcheck disable=SC2086
  for cert in $pattern; do
    [[ -f "$cert" ]] || continue
    found=1
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "DRY-RUN: Would remove: $cert"
    else
      sudo rm -f "$cert"
      log "Removed: $cert"
    fi
  done

  [[ "$found" -eq 1 ]] || log "No installed certificates found for prefix: $CERT_PREFIX"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "DRY-RUN: Would run: sudo update-ca-certificates"
    return 0
  fi
  sudo update-ca-certificates
}

fetch_chain_pem() {
  local host="$1" out="$2"
  debug "Fetching certificate chain from: $host"
  echo | openssl s_client -showcerts -servername "$host" -connect "$host:443" 2>/dev/null \
    | sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' > "$out"
  grep -q "BEGIN CERTIFICATE" "$out"
}

fetch_and_install_from_hosts() {
  log "Fetching certificate chains from configured hosts."
  local installed=0

  for host in "${HOSTS[@]}"; do
    local pem="$WORKDIR/$host.pem"
    if ! fetch_chain_pem "$host" "$pem"; then
      warn "No certificates captured from $host."
      continue
    fi

    csplit -f "$WORKDIR/$host-cert-" "$pem" '/-----BEGIN CERTIFICATE-----/' '{*}' >/dev/null 2>&1 || true
    for chunk in "$WORKDIR"/"$host"-cert-*; do
      grep -q "BEGIN CERTIFICATE" "$chunk" || continue
      is_valid_x509 "$chunk" || { debug "Skipping invalid x509 chunk from $host"; continue; }
      is_ca_true "$chunk" || { debug "Skipping non-CA certificate from $host: $(subject_line "$chunk")"; continue; }
      matches_allowlist "$chunk" || { debug "Skipping CA not matching allowlist: $(subject_line "$chunk")"; continue; }
      install_cert_pem "$chunk" && installed=$((installed + 1))
    done
  done

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "Dry-run: network capture stage completed."
  elif [[ "$installed" -gt 0 ]]; then
    sudo update-ca-certificates
  else
    warn "No corporate CA certificates were installed. They may already be trusted, or the hosts/allowlist need adjustment."
  fi
}

curl_test_url() {
  local url="$1" out rc code
  out="$(curl -sS -L --connect-timeout "$CURL_CONNECT_TIMEOUT" --max-time "$CURL_MAX_TIME" \
    -o /dev/null -w "%{http_code}" -I "$url" 2>&1)"
  rc=$?
  code="${out##*$'\n'}"

  if [[ "$rc" -eq 0 && "$code" != "000" ]]; then
    log "OK: $url (HTTP $code)"
    return 0
  fi
  if printf "%s\n" "$out" | grep -qi "SSL certificate problem"; then
    warn "FAILED: $url (TLS verification failed; corporate CA may be missing from trust)"
  elif printf "%s\n" "$out" | grep -qi "Could not resolve host"; then
    warn "FAILED: $url (DNS resolution failed)"
  elif printf "%s\n" "$out" | grep -qi "timed out"; then
    warn "FAILED: $url (connection timed out)"
  else
    warn "FAILED: $url (curl error; run with --verbose for details)"
  fi
  return 1
}

main() {
  [[ "${EUID:-$(id -u)}" -ne 0 ]] || warn "Running as root is not recommended; sudo is used only when needed."
  need_cmd openssl
  need_cmd sed
  need_cmd grep
  need_cmd csplit
  need_cmd curl

  load_config
  if [[ "$PRINT_CONFIG" -eq 1 ]]; then
    print_config
    exit 0
  fi
  validate_config
  ensure_tmp_permissions

  if [[ "$DO_CLEANUP" -eq 1 ]]; then
    cleanup_installed_certs
    log "Log file: $LOG_FILE"
    exit 0
  fi

  fetch_and_install_from_hosts

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "Dry-run completed."
    log "Log file: $LOG_FILE"
    exit 0
  fi

  if [[ "${#TEST_URLS[@]}" -gt 0 ]]; then
    log "Testing HTTPS connectivity."
    local failed=0
    for url in "${TEST_URLS[@]}"; do
      curl_test_url "$url" || failed=1
    done
    [[ "$failed" -eq 0 ]] || warn "Some HTTPS tests failed. Verify VPN/proxy connectivity or run with --verbose."
  fi
  log "Log file: $LOG_FILE"
}

main
